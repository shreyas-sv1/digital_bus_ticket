# ============================================
# Bus Ticketing System - Environment Variables
# ============================================

# --- Required Secrets (MUST be changed in production) ---
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET= REPLACE_WITH_64_CHAR_HEX_SECRET
QR_SIGN_SECRET= REPLACE_WITH_64_CHAR_HEX_SECRET

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_SECRET

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Server Configuration ---
PORT=3001
FRONTEND_URL=http://localhost:3000

# ============================================
# Secret Regeneration Guide
# ============================================
# 1. JWT_SECRET: Used to sign authentication tokens
#    Regenerate if compromised or every 90 days
#    Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. QR_SIGN_SECRET: Used to sign ticket QR codes (prevents forgery)
#    Regenerate if compromised (invalidates all existing QR codes)
#    Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 3. RAZORPAY_KEY_SECRET: Provided by Razorpay dashboard
#    Regenerate from Razorpay dashboard if compromised
# ============================================
