# ============================================
# BMTC SmartTicket Frontend - Environment Variables
# ============================================
# NOTE: Environment variables starting with NEXT_PUBLIC_ are exposed to the browser
# NEVER put secrets in this file - only public configuration

# --- Backend API URLs ---
# Set these to your backend deployment URL
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- Razorpay Configuration (Test Mode) ---
# Get these from: https://dashboard.razorpay.com/app/keys
# Use TEST keys for development, PRODUCTION keys for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# --- Environment ---
NODE_ENV=development

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Update NEXT_PUBLIC_API_URL to your backend:
#    Development: http://localhost:3001
#    Production: https://your-backend.up.railway.app
#
# 3. Update NEXT_PUBLIC_SOCKET_URL to same as API_URL
#    (WebSocket uses same domain as REST API)
#
# 4. Get Razorpay keys from dashboard:
#    Test: https://dashboard.razorpay.com/app/keys (test mode)
#    Production: Use production keys only for live deployment
#
# 5. Start development server:
#    npm run dev
#    Visit: http://localhost:3000
#
# ============================================
# Production Deployment
# ============================================
# For Vercel deployment, set these in Project Settings > Environment Variables:
# - NEXT_PUBLIC_API_URL (to your production backend URL)
# - NEXT_PUBLIC_SOCKET_URL (same as API_URL)
# - NEXT_PUBLIC_RAZORPAY_KEY_ID (production key)
